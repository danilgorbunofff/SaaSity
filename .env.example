# Copy to .env and fill in real values. Never commit the filled-in .env.
#
# Every variable is labeled with which environments read it and whether its
# VALUE should differ per environment:
#   [all envs, own value]         local/preview/production all need this set,
#                                  each with its own value — never share one
#                                  value across environments.
#   [local + preview ONLY]        must never be set in production.
#   [future / M3, per-env value]  not read by any code yet; documented ahead
#                                  of Stripe integration landing.

# ---- Required (all environments) ----------------------------------------

# [all envs, own value] PostgreSQL connection string used by Prisma. Every
# environment needs its own database — never point preview/production at
# the same DATABASE_URL as local dev.
DATABASE_URL="postgresql://user:password@localhost:5432/saasity"

# [all envs, own value] HMAC secret that signs the anonymous bidder-identity
# cookie. Any long random string; rotating it logs every existing bidder out
# (new bidderId). A leaked local/preview secret must never let someone forge
# cookies against production, so never reuse one value across environments.
BIDDER_COOKIE_SECRET="change-me-to-a-long-random-string"

# ---- Worker / cron -------------------------------------------------------

# [all envs, own value] Shared secret required by GET/POST /api/cron/resolve
# (expiry-sweep worker). Required in any environment that wires an external
# cron caller to that route; without it the route always returns 401. No
# default — generate a long random string per deployment, never reused
# across environments.
WORKER_SECRET="change-me-to-a-long-random-string"

# ---- Payments (pre-Stripe mock loop) -------------------------------------

# [local + preview ONLY — never production] Set to "1" to enable the
# mock-payments loop (phase 2.5): capture/cancel/authorize stubs in
# src/server/auction/finalize.ts succeed without moving real money, so the
# full claim -> bid -> resolve -> next-cycle loop is exercisable end to end
# before Stripe is wired (milestone M3). Leave unset (or any value other
# than "1") in any deployment that should never crown a paying "winner"
# without a real payment — with it unset, every capture throws and a
# resolution with no successful capture reverts the plot to IDLE instead of
# activating an unpaid tenant. Production must never set this.
MOCK_PAYMENTS="1"

# ---- Stripe (milestone M3 — not yet wired) -------------------------------

# [future / M3, per-env value] Real payments replace the MOCK_PAYMENTS
# stubs with Stripe SetupIntent (at pre-bid attach time) and manual-capture
# PaymentIntent (at resolution) calls. Unused until M3 lands; left here so
# the shape is documented ahead of time. Once wired: local/preview use
# Stripe test-mode keys, production uses live-mode keys — never share a key
# across that boundary.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

