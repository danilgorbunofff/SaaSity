# Copy to .env and fill in real values. Never commit the filled-in .env.

# ---- Required (all environments) ----------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/saasity"

# HMAC secret that signs the anonymous bidder-identity cookie. Any long
# random string; rotating it logs every existing bidder out (new bidderId).
BIDDER_COOKIE_SECRET="change-me-to-a-long-random-string"

# ---- Worker / cron -------------------------------------------------------

# Shared secret required by GET/POST /api/cron/resolve (expiry-sweep worker).
# Required in any environment that wires an external cron caller to that
# route; without it the route always returns 401. No default — generate a
# long random string per deployment.
WORKER_SECRET="change-me-to-a-long-random-string"

# ---- Payments (pre-Stripe mock loop) -------------------------------------

# Set to "1" to enable the mock-payments loop (phase 2.5): capture/cancel/
# authorize stubs in src/server/auction/finalize.ts succeed without moving
# real money, so the full claim -> bid -> resolve -> next-cycle loop is
# exercisable end to end before Stripe is wired (milestone M3). Leave unset
# (or any value other than "1") in any deployment that should never crown a
# paying "winner" without a real payment — with it unset, every capture
# throws and a resolution with no successful capture reverts the plot to
# IDLE instead of activating an unpaid tenant.
MOCK_PAYMENTS="1"

# ---- Stripe (milestone M3 — not yet wired) -------------------------------

# Real payments replace the MOCK_PAYMENTS stubs with Stripe SetupIntent (at
# pre-bid attach time) and manual-capture PaymentIntent (at resolution) calls.
# Unused until M3 lands; left here so the shape is documented ahead of time.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
