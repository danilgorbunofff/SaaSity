// SaaSity — auction/lease model.
// Plots are never sold: they cycle forever between IDLE (no open cycle) and
// LIVE (an active AuctionCycle with a leading PreBid). Tier economics live in
// src/lib/tiers.ts, not here — each cycle snapshots its tier's floor/increment
// at creation (clean-slate reset, no cross-cycle price escalation).
//
// Auction status and tenancy are DELIBERATELY separate concepts (Part 1
// lifecycle fix, Model A): PlotStatus tracks whether bidding is currently
// open for the *next* lease; Plot.tenant* tracks who is *currently displayed*
// on the billboard. A plot can be IDLE (no open auction) while still having
// an active tenant, and it can be LIVE (someone bidding for the next lease)
// while an unrelated tenant from a previous cycle remains displayed. The
// tenant only changes at successful settlement (engine#activateTenant) —
// never mid-auction, and never wiped by a later auction opening or failing.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlotTier {
  OUTER
  MID
  CORE
}

enum PlotStatus {
  IDLE
  LIVE
}

enum CycleStatus {
  OPEN
  RESOLVING
  RESOLVED
  CANCELLED
}

enum PreBidStatus {
  ACTIVE
  WON
  LOST
  CANCELLED
  EXPIRED
}

enum SettlementKind {
  CAPTURE
  RELEASE
}

enum SettlementStatus {
  // CAPTURE lifecycle: recorded before the Stripe call, terminal after.
  PENDING
  CAPTURED
  FAILED_RETRYABLE
  FAILED_DEFINITIVE
  // RELEASE lifecycle: holds on losing candidates are released, never
  // blocking settlement; failures persist for sweep retry.
  RELEASED
  RELEASE_FAILED
}

model Plot {
  id      String   @id
  tier    PlotTier
  originX Int
  originY Int
  spanX   Int
  spanY   Int

  status PlotStatus @default(IDLE)

  currentCycleId String? @unique
  currentCycle   AuctionCycle? @relation("PlotCurrentCycle", fields: [currentCycleId], references: [id])
  // Denormalized pointer to the CURRENT AUCTION's leading PreBid (display
  // cache, maintained transactionally by the M2 engine — no FK by design).
  // Auction-progress only: an opaque id a bidder matches against their own
  // PreBid ids to derive "am I leading". Never paired with a public brand —
  // the provisional leader of an open auction is not yet a tenant and must
  // not receive free billboard exposure before they actually win and pay.
  currentLeaderPreBidId String?

  // The ACTIVE TENANT — the last bidder who actually won and was captured.
  // Distinct from currentLeaderPreBidId: this is who is PUBLICLY DISPLAYED
  // on the billboard, independent of whether an auction is currently open
  // for the *next* lease. Only src/server/auction/engine.ts#activateTenant
  // may write these fields, and only at successful settlement.
  tenantPreBidId String?
  tenantSince    DateTime?

  // Tenant's PUBLIC brand snapshot (display cache, no secrets here —
  // PreBid.maxBidCents is the only private field in the system and it never
  // lands on Plot).
  tenantCompanyName   String?
  tenantTagline       String?
  tenantTwitterHandle String?
  tenantLogoUrl       String?
  tenantMrrText       String?
  tenantLogoHidden    Boolean @default(false)
  // Tenant's public marketing URL, shown on the detail card ("Visit site").
  // Public display-cache field, not part of PreBid privacy.
  tenantTargetUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycles  AuctionCycle[]
  preBids PreBid[]
  bids    Bid[]

  @@index([status])
  @@index([originX, originY])
  @@index([tier])
}

model AuctionCycle {
  id     String      @id @default(cuid())
  plotId String
  plot   Plot        @relation(fields: [plotId], references: [id])
  status CycleStatus @default(OPEN)

  // Snapshot at creation (clean-slate rule) — never derived from lib/tiers
  // after this point.
  floorPriceCents Int
  incrementCents  Int
  durationMinutes Int

  startedAt DateTime @default(now())
  endAt     DateTime

  // Soft-close bookkeeping: +3min per triggered extension, capped in code.
  softCloseExtensions Int @default(0)

  // Set by the resolution worker.
  clearingPriceCents Int?
  resolvedAt         DateTime?
  winnerPreBidId     String?

  // Display cache maintained transactionally by the M2 engine on every bid:
  // floor when a single bidder; min(leader.maxBid, second.maxBid + increment)
  // otherwise. Null until first claim/bid.
  currentPriceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preBids PreBid[]
  bids    Bid[]

  // Part 3 capture-replay: persisted settlement state machine. Every
  // money-moving intent (CAPTURE) and money-releasing intent (RELEASE) is
  // recorded here BEFORE the Stripe call, so a crash at any point resumes
  // from this ledger instead of guessing. Rows are audit trail — never
  // updated except for their own status transitions, never deleted except
  // with their cycle.
  settlementAttempts SettlementAttempt[]

  // Inverse of Plot.currentCycle ("which cycle is this plot currently running")
  currentForPlot Plot? @relation("PlotCurrentCycle")

  @@index([status, endAt])
  @@index([plotId, status])
}

// The single bidding primitive: claims, manual bids and scheduled proxy
// pre-bids all create/raise a PreBid (claim = pre-bid at tier floor on an
// IDLE plot, which spins up its cycle).
model PreBid {
  id      String        @id @default(cuid())
  cycleId String? // null = targets the next not-yet-created cycle on this plot
  cycle   AuctionCycle? @relation(fields: [cycleId], references: [id])
  plotId  String
  plot    Plot          @relation(fields: [plotId], references: [id])

  // Anonymous bidder identity from the HMAC-signed cookie (no Bidder table).
  bidderId         String
  stripeCustomerId String?

  // Stripe pre-authorization for maxBid (PaymentIntent, capture_method=manual),
  // created at cycle-attach time (7-day hold limit). Unique so one
  // PaymentIntent can never settle two PreBids — Postgres unique indexes
  // allow unlimited NULLs, so this is safe pre-M3 (no row sets this field
  // yet). Writers MUST go through
  // src/server/auction/payment-intent.ts#attachStripePaymentIntentId so a
  // retried attach is idempotent instead of a generic failure.
  stripePaymentIntentId String? @unique

  // PRIVATE — never serialized into any public payload.
  maxBidCents Int

  // Public brand submitted with the bid (mirrors the shared 2.1 form
  // contract). Only maxBidCents is private — the brand is not, but it is
  // projected onto Plot's tenant* display cache ONLY at successful paid
  // settlement (engine#activateTenant) — never while merely leading an
  // open auction (Part 1 lifecycle fix: no free exposure before payment).
  companyName   String
  tagline       String?
  targetUrl     String
  twitterHandle String
  mrrText       String?

  status PreBidStatus @default(ACTIVE)

  // Set when this pre-bid leaves ACTIVE without winning: capture_failed
  // (cascade), expired (attach-time auth failure), cancelled.
  lostReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids Bid[]

  @@index([cycleId, status])
  @@index([plotId, bidderId])
  @@index([bidderId, status])
}

// Append-only audit ledger of price ticks. amountCents is the tick amount,
// never a bidder's maxBid.
model Bid {
  id          String       @id @default(cuid())
  cycleId     String
  cycle       AuctionCycle @relation(fields: [cycleId], references: [id])
  plotId      String // denormalized for fast per-plot ledger queries
  plot        Plot         @relation(fields: [plotId], references: [id])
  preBidId    String?
  preBid      PreBid?      @relation(fields: [preBidId], references: [id])
  bidderId    String
  amountCents Int
  isProxy     Boolean      @default(false)
  // True when this tick is the one that triggered a soft-close extension
  // (audit trail so an extension can never be double-attributed).
  triggeredExtension Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([cycleId, createdAt])
  @@index([plotId, createdAt])
}

// Part 3 capture-replay: persisted settlement state machine (one row per
// money intent). The worker records a PENDING row BEFORE every Stripe call
// and transitions it after; any crash resumes from this ledger:
//   - a CAPTURED row is a confirmed charge — reconcile settles from the
//     record and the cycle is never reopened without reconciliation;
//   - the idempotencyKey is stable across worker retries for the same
//     intended settlement (M3 passes it to Stripe), so "already captured"
//     is success, never a double charge;
//   - FAILED_DEFINITIVE selects the next fallback candidate;
//     FAILED_RETRYABLE aborts the pass (no fallback on unknown money state)
//     and retries on the next sweep with the same key;
//   - RELEASE rows track hold releases on losers; RELEASE_FAILED persists
//     for sweep retry instead of being swallowed.
model SettlementAttempt {
  id      String       @id @default(cuid())
  cycleId String
  cycle   AuctionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  // No FK to PreBid by design: rows are the audit trail, keyed by id.
  preBidId String

  kind   SettlementKind
  status SettlementStatus @default(PENDING)

  // 1-based per (cycle, preBid, kind): retries add rows, never mutate history.
  attemptNo Int

  // CAPTURE only: the intended charge. Part of the idempotency key — the
  // same bidder re-attempted at a different price is a different settlement.
  amountCents Int?

  // Stable across retries for the same intended settlement; M3 passes it as
  // the Stripe idempotency key. Non-unique (retries share it) — "already
  // captured under this key" is looked up, not constraint-violated.
  idempotencyKey String

  stripePaymentIntentId String?
  // Raw Stripe result / error code payload (JSON text, audit only).
  stripeResult String?
  // transport | card | conflict | release — why a FAILED row failed.
  failureKind String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, preBidId, kind, attemptNo])
  @@index([cycleId, status])
  @@index([idempotencyKey])
}
